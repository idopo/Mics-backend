# Python
__pycache__/
*.py[cod]
*.pyo

# Node
web_ui/react-src/node_modules/
web_ui/react-src/dist/
web_ui/react-src/package-lock.json
web_ui/react-src/tsconfig.tsbuildinfo

# Static build output
web_ui/static/react/

# Logs
*.log

# Docker
*.env.local

# Local scratch workspaces — not part of the backend
first_cohort_analysis_noa/
poster_figures/
learning task/
scratchpad/

# analysis/: outputs are ignored, but the scripts and data stay version-controlled.
# The `!analysis/**/` line is required — git cannot re-include a file whose parent
# directory is excluded, so directories must be re-included before their contents.
analysis/**
!analysis/**/
!analysis/**/*.py
!analysis/**/*.csv
!analysis/**/*.txt
!analysis/**/*.md
!analysis/**/*.yml
!analysis/**/*.gitignore

# Generated figures and documents anywhere in the tree
*.png
*.svg
*.pdf
*.pptx

# ...except real app assets, which the web UI ships
!web_ui/**/*.png
!web_ui/**/*.svg

# Docker secrets - real credentials, never commit (see 2026-08-30 incident)
secrets/

# Python build artifacts from the two redistributable client packages (sdk/, dlc_link/).
# `python -m build` regenerates all of these; none belong in the repo. Named here because
# renaming a distribution renames its egg-info directory, which is how an untracked
# artifact quietly became a staged file once.
*.egg-info/
sdk/build/
sdk/dist/
dlc_link/build/
dlc_link/dist/
